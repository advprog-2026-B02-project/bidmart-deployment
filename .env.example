# docker hub username tempat image dipull
DOCKERHUB_USERNAME=your_dockerhub_username_here

# gunakan string acak Base64 untuk token internal dan session
SESSION_SECRET=your_base64_session_secret_here
INTERNAL_SERVICE_TOKEN=your_base64_internal_token_here
JWT_SECRET=your_jwt_secret_key_here

# resend API Key (untuk fitur email auth)
RESEND_API_KEY=re_your_resend_api_key_here

# email credentials for smtp
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password_here
MAIL_FROM_EMAIL=your_email@gmail.com

# frontend URL
APP_FRONTEND_URL=your_frontend_url_here

# feature flag deployment strategy
# set false untuk menonaktifkan domain fitur dari frontend tanpa rebuild image
# bidding otomatis dianggap off saat wallet off karena hold saldo bergantung pada wallet-service
FEATURE_ADMIN_ENABLED=true
FEATURE_BIDDING_ENABLED=true
FEATURE_NOTIFICATIONS_ENABLED=true
FEATURE_ORDERS_ENABLED=true
FEATURE_SELLER_ENABLED=true
FEATURE_WALLET_ENABLED=true

# ------------------------------------------------------------------------------
# DATABASE CREDENTIALS PER MICROSERVICE (NEON DB)
# ------------------------------------------------------------------------------

# AUTH DATABASE
AUTH_DATABASE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/neondb?sslmode=require
AUTH_DATABASE_USERNAME=neondb_owner
AUTH_DATABASE_PASSWORD=your_auth_db_password

# BIDDING DATABASE
BIDDING_DATABASE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/neondb?sslmode=require
BIDDING_DATABASE_USERNAME=neondb_owner
BIDDING_DATABASE_PASSWORD=your_bidding_db_password

# ORDER DATABASE
ORDER_DATABASE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/order_db?sslmode=require
ORDER_DATABASE_USERNAME=neondb_owner
ORDER_DATABASE_PASSWORD=your_order_db_password

# NOTIFICATION DATABASE
NOTIF_DATABASE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/notif_db?sslmode=require
NOTIF_DATABASE_USERNAME=neondb_owner
NOTIF_DATABASE_PASSWORD=your_notif_db_password

# CATALOG DATABASE
CATALOG_DATABASE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/catalog_db?sslmode=require
CATALOG_DATABASE_USERNAME=neondb_owner
CATALOG_DATABASE_PASSWORD=your_catalog_db_password

# WALLET DATABASE
WALLET_DATABASE_URL=jdbc:postgresql://ep-xxx.aws.neon.tech/wallet_db?sslmode=require
WALLET_DATABASE_USERNAME=neondb_owner
WALLET_DATABASE_PASSWORD=your_wallet_db_password
