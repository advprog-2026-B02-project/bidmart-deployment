# Copy to profiling/profile.env and adjust IDs/tokens from staging or local seed data.

DURATION=5m
STRICT=false

AUTH_URL=http://auth-service:8081
BIDDING_URL=http://bidding-service:8082
CATALOG_URL=http://catalog-service:8083
WALLET_URL=http://wallet-service:8084
ORDER_URL=http://order-service:8085
NOTIFICATION_URL=http://notification-service:8086
FRONTEND_URL=http://frontend:3000

USER_ID=00000000-0000-4000-8000-000000000001
LISTING_ID=
AUCTION_ID=
ORDER_ID=

# Optional. Fill for authenticated auth/wallet/frontend paths.
AUTH_EMAIL=
AUTH_PASSWORD=
JWT_TOKEN=
BIDMART_SESSION=

AUTH_VUS=3
CATALOG_VUS=10
BIDDING_VUS=5
WALLET_VUS=5
ORDER_VUS=5
NOTIFICATION_VUS=5
FRONTEND_VUS=5
